imp <iostrpm>;
namesp test;
int main() {
    int i = 0;
    int sum = 0;
    while (i < 5) {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);
    if (sum > 9) {
        print(1, int);
    } else {
        print(0, int);
    }
    for (ch in "AB") {
        print(ch);
    }
    ret 0;
}
